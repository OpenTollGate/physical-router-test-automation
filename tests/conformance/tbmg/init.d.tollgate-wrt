#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

PROG=/usr/bin/tollgate-wrt
PIDFILE=/var/run/tollgate-wrt.pid

EXTRA_COMMANDS="status"
EXTRA_HELP="        status          Check service status"

start_service() {
    # Start cron daemon
    /etc/init.d/cron start

    # Now start the TollGate service
    procd_open_instance
    procd_set_param command "$PROG"

    # Set working directory explicitly to /
    procd_set_param directory /

    # Ensure logs are saved
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /tmp/tollgate-debug.log

    # Set environment variables
    procd_set_param env TOLLGATE_DEBUG=1

    # Add dependency on nodogsplash
    procd_set_param depends nodogsplash

    # Add respawn parameters: tries 3 times with 5-second intervals and retries indefinitely
    procd_set_param respawn 3 5 0

    # Managed-instance pid file for operators
    procd_set_param pidfile "$PIDFILE"

    procd_close_instance

    # Log the start for debugging
    echo "TollGate basic started with nodogsplash" > /tmp/basic.log
}

# procd terminates its own instance after this hook. Anything it does NOT
# own — a manual/setsid start, a leftover debug session — must be swept
# here: a stray holder of :2121 outlives every service restart and keeps
# serving stale in-memory state (rate limiter, wallet caches) while the
# procd instance crash-loops on the busy port (Amperstrand/
# tollgate-module-basic-rust#27 — the rust port inherited this script's
# logging-only stop() verbatim). This hook must be stop_service(), never
# an overridden stop() — the override replaces rc.common's procd_kill
# teardown and broke restart/stop entirely.
stop_service() {
    local pids tries

    pids=$(pgrep -f "^${PROG}" 2>/dev/null)
    [ -n "$pids" ] && kill $pids 2>/dev/null

    tries=0
    while [ "$tries" -lt 5 ] && pgrep -f "^${PROG}" >/dev/null 2>&1; do
        sleep 1
        tries=$((tries + 1))
    done

    pids=$(pgrep -f "^${PROG}" 2>/dev/null)
    [ -n "$pids" ] && kill -9 $pids 2>/dev/null

    rm -f "$PIDFILE"
    echo "TollGate basic stopped and nodogsplash disabled" >> /tmp/basic.log
}

status() {
    if pgrep -f "^${PROG}" >/dev/null; then
        echo "TollGate basic is running"
        nds_status=$(/etc/init.d/nodogsplash status)
        echo "NoDogSplash: $nds_status"
        return 0
    else
        echo "TollGate basic is not running"
        return 1
    fi
}
