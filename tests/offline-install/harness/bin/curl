#!/usr/bin/env bash
# TEST DOUBLE for curl — the HTTP surface model for both sides of the verification:
#   * the router-side surface probe (http://127.0.0.1:PORT/) and the BOLT11 quote
#     (POST http://127.0.0.1:2121/ln-invoice), and
#   * the br-lan client probes the laptop driver runs (http://192.168.1.1:PORT/).
#
# Codes come from <root>/var/lib/tgoffline-harness/http_codes (port → code).  Ports
# 8090/8443 are DERIVED from the guard state on purpose: with the admin-board guard
# loaded into fw4 they are refused (000), and without it they answer 200 — which is the
# actual failure mode the guard exists to prevent.
set -uo pipefail

ROOT="${TGOFFLINE_HARNESS_ROOT:?the harness must export TGOFFLINE_HARNESS_ROOT}"
HSTATE="$ROOT/var/lib/tgoffline-harness"

url=""; write_out=""; fmt=""; method="GET"; data=""
while [ $# -gt 0 ]; do
    case "$1" in
        -o) write_out="$2"; shift 2 ;;
        -w) fmt="$2"; shift 2 ;;
        -X) method="$2"; shift 2 ;;
        -d|--data|--data-raw) data="$2"; shift 2 ;;
        -H|-m|--max-time|-A|-u) shift 2 ;;
        http://*|https://*) url="$1"; shift ;;
        *) shift ;;
    esac
done

scheme="${url%%://*}"
rest="${url#*://}"
hostport="${rest%%/*}"
path="/${rest#*/}"
[ "$path" = "/$rest" ] && path="/"
port="${hostport##*:}"
case "$hostport" in
    *:*) : ;;
    *) [ "$scheme" = https ] && port=443 || port=80 ;;
esac
[ -n "$port" ] || port=80

guard_loaded() { [ -f "$HSTATE/nft_admin_board_input_guard" ]; }
port_dead() { [ -f "$HSTATE/port_dead_$1" ]; }

# Codes come from the per-PATH model first (<root>/var/lib/tgoffline-harness/
# http_path_codes: `port path code`), then the per-PORT default (http_codes: `port code`).
# The path model exists because the surfaces do NOT all answer on `/`: the portal serves
# /splash.html (bare `/` is 404) and :8080 answers no plain HTTP at all.  Probing `/` and
# calling 404 a failure is exactly the defect this model pins down.
code_for() { # $1=port  $2=path
    if port_dead "$1"; then printf '000'; return; fi
    explicit="$(awk -v p="$1" -v q="$2" '$1 == p && $2 == q { print $3 }' "$HSTATE/http_path_codes" 2>/dev/null | head -1)"
    if [ -n "$explicit" ]; then printf '%s' "$explicit"; return; fi
    explicit="$(awk -v p="$1" '$1 == p { print $2 }' "$HSTATE/http_codes" 2>/dev/null | head -1)"
    if [ -n "$explicit" ]; then printf '%s' "$explicit"; return; fi
    case "$1" in
        8090|8443) if guard_loaded; then printf '000'; else printf '200'; fi ;;
        *) printf '000' ;;
    esac
}

body=""
code="$(code_for "$port" "$path")"

# the BOLT11 quote endpoint (the module's real route: POST /ln-invoice {"amount":21}).
# Which answer it gives depends on the UPLINK, exactly as the hardware showed:
#   * with an uplink       -> 200 + a BOLT11 invoice
#   * without one          -> 503 "merchant is still initializing" (kashu.me DNS failed on
#                             the 2026-09-28 WAN-less run) and NO quote: degraded, not wedged
#   * `ln_invoice_answer`  -> an explicitly modelled answer (the "route missing" control)
#   * `no-bolt11`          -> 500 {"error":"no wallet configured"} (the no-quote control)
case "$path" in
    /ln-invoice)
        if [ "$method" = POST ]; then
            if [ -f "$HSTATE/no-bolt11" ]; then
                code=500
                body='{"error":"no wallet configured"}'
            elif [ -f "$HSTATE/ln_invoice_answer" ]; then
                code="$(awk '{print $1}' "$HSTATE/ln_invoice_answer" | head -1)"
                body="$(cut -d' ' -f2- "$HSTATE/ln_invoice_answer" | head -1)"
                [ -n "$code" ] || code=500
            elif [ -f "$HSTATE/no-uplink" ]; then
                code=503
                body='{"error":"merchant is still initializing: mint unreachable (no uplink)","payment_request":null}'
            else
                code=200
                body='{"quote":"harness-quote-1","payment_hash":"00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff","payment_request":"lnbc21n1p3harness20bolt11invoice20stand20in20for20tests20only20qqqqqqqqqqqqqqqqqqqqqqq"}'
            fi
        else
            code=200
            body='{"status":"unpaid"}'
        fi
        ;;
esac

# A one-shot "not up yet" model: <root>/var/lib/tgoffline-harness/slow_once_<port>
# makes the FIRST probe of that port answer 000 and consumes the marker, so a test can
# prove the bounded wait recovers from a service that is still starting (the exact
# 2026-09-28 hardware shape, where the surfaces answered 000 and a re-probe was 200).
if [ -f "$HSTATE/slow_once_$port" ]; then
    rm -f "$HSTATE/slow_once_$port"
    code=000
    body=""
fi

if [ -n "$write_out" ] && [ "$write_out" != "/dev/null" ]; then
    printf '%s' "$body" > "$write_out"
fi

if [ -n "$fmt" ]; then
    case "$fmt" in
        *'{http_code}'*) printf '%s' "$code" ;;
        *) printf '%s' "$fmt" ;;
    esac
else
    printf '%s' "$body"
fi
exit 0
