# ── Router connection ──────────────────────────────────────────────
TOLLGATE_BACKEND=go
TOLLGATE_SSH_HOST=
TOLLGATE_SSH_USER=root
TOLLGATE_SSH_KEY=~/.ssh/id_ed25519
TOLLGATE_SSH_PASSWORD=
TOLLGATE_LUCI_URL=http://192.168.13.112:8080
TOLLGATE_LUCI_USER=root
TOLLGATE_LUCI_PASSWORD=

# ── Router inventory (multi-router labs) ──────────────────────────
TOLLGATE_ROUTER_ID=
TOLLGATE_ROUTER_INVENTORY=config/routers.json
TOLLGATE_ROUTER_MODEL=
TOLLGATE_ROUTER_ARCH=aarch64_cortex-a53

# ── WiFi / network ────────────────────────────────────────────────
TOLLGATE_SSID=TollGate
TOLLGATE_SSID_PREFIX=TollGate-
TOLLGATE_WIFI_INTERFACE=
TOLLGATE_UPSTREAM_SSID=
TOLLGATE_UPSTREAM_WIFI_PASSWORD=
TOLLGATE_DOMAIN=
TOLLGATE_ENABLE_WIFI_CLIENT_TESTS=false

# ── Phone testing ─────────────────────────────────────────────────
PHONE_SERIAL=

# ── Virtual lab ──────────────────────────────────────────────────────
TOLLGATE_VIRTUAL_LAB=true
TOLLGATE_CLIENT_TYPE=container
TOLLGATE_CLIENT_IP=10.99.99.100
TOLLGATE_CONTAINER_HOST=
TOLLGATE_SSH_JUMP_HOST=
TOLLGATE_V2_MINT_URL=https://testnut.cashu.space
TOLLGATE_RECORD_ALL=

# ── Payment / protocol ────────────────────────────────────────────
TOLLGATE_PAYMENT_STEPS=100
TOLLGATE_CONNECTIVITY_HOST=8.8.8.8
TOLLGATE_TEST_MINT_URL=https://testnut.cashu.exchange
TOLLGATE_LOCAL_MINT_URL=http://10.99.99.1:8085
TOLLGATE_LOCAL_502_MINT_URL=http://10.99.99.1:8086

# ── Data allotment ────────────────────────────────────────────────
TOLLGATE_ENABLE_DATA_ALLOTMENT_TESTS=false
TOLLGATE_DATA_TEST_URL=https://nbg1-speed.hetzner.com/100MB.bin
TOLLGATE_DATA_TEST_TIMEOUT=300

# ── Firmware / flashing ──────────────────────────────────────────
TOLLGATE_PACKAGE_PATH=
TOLLGATE_ETHERNET_INTERFACES=
TOLLGATE_FIRMWARE_IMAGE=
TOLLGATE_ENABLE_SYSUPGRADE_TESTS=false
TOLLGATE_ENABLE_SYSUPGRADE_FLASHING=false
TOLLGATE_SYSUPGRADE_WIPE_CONFIG=false

# ── Playwright ────────────────────────────────────────────────────
TOLLGATE_VIEWPORT=desktop

# ── Report publishing ─────────────────────────────────────────────
TOLLGATE_PUBLISH=false
TOLLGATE_BRANCH=
TOLLGATE_PR=
TOLLGATE_GH_PAGES_KEEP=10
