#!/usr/bin/env bash
#
# Pre-commit hook: run shellcheck on staged .sh files.
# Install: ./scripts/setup-hooks.sh
# Skip:    git commit --no-verify
#
set -euo pipefail

if ! command -v shellcheck &>/dev/null; then
  echo "shellcheck not found — skipping shell lint."
  echo "Install: brew install shellcheck"
  exit 0
fi

# Get staged .sh files (excluding deleted files)
staged_sh_files=()
while IFS= read -r file; do
  if [[ -f "$file" ]]; then
    staged_sh_files+=("$file")
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.sh')

if [[ ${#staged_sh_files[@]} -eq 0 ]]; then
  exit 0
fi

echo "Running shellcheck on ${#staged_sh_files[@]} staged shell script(s)..."

if ! shellcheck -s bash -S warning "${staged_sh_files[@]}"; then
  echo ""
  echo "shellcheck found issues. Fix them or commit with --no-verify to skip."
  exit 1
fi

exit 0
