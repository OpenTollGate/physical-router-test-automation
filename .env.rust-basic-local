# Local-binary testing env for tollgate-module-basic-rust (rust-basic backend)
# Usage: cp .env.rust-basic-local .env && make pytest-smoke-rust-basic

TOLLGATE_BACKEND=rust-basic
TOLLGATE_VIRTUAL_LAB=true
TOLLGATE_LOCAL_RUN=true
TOLLGATE_BINARY_PATH=/home/ubuntu/src/tollgate-module-basic-rust/target/release/tollgate-module-basic-rust
TOLLGATE_TEST_CONFIG_DIR=/tmp/tollgate-rust-basic-test-config
TOLLGATE_HTTP_HOST=127.0.0.1
TOLLGATE_HTTP_PORT=2121
TOLLGATE_CLI_SOCKET=/var/run/tollgate.sock
TOLLGATE_ROUTER_ARCH=x86_64

# Cashu mint (use public testmint for local testing)
TOLLGATE_TEST_MINT_URL=https://testnut.cashu.exchange
TOLLGATE_LOCAL_MINT_URL=https://testnut.cashu.exchange

# No SSH — local subprocess
TOLLGATE_SSH_HOST=
TOLLGATE_SSH_USER=
TOLLGATE_SSH_KEY=