#!/usr/bin/env bash
# Pre-commit hook: gitleaks staged scan + ruff on staged Python.
# Install with: git config core.hooksPath hooks
# gitleaks (optional but recommended): go install github.com/zricethezav/gitleaks/v8@v8.30.1
#   — same pinned version as CI; set GITLEAKS_REQUIRED=1 to fail-closed when absent.
set -euo pipefail

# Secrets are cheap to remove BEFORE the commit and expensive after push.
# Complements, not replaces, the CI scan (bypassable with --no-verify,
# only covers machines with the hook installed). This repo has history:
# a lab-router password lived in git history (issue #7).
if command -v gitleaks >/dev/null 2>&1; then
    echo "🔍 gitleaks: scanning staged changes..."
    gitleaks protect --staged --redact --verbose
elif [ -n "${GITLEAKS_REQUIRED:-}" ]; then
    echo "❌ gitleaks not found and GITLEAKS_REQUIRED is set"
    echo "   install: go install github.com/zricethezav/gitleaks/v8@v8.30.1"
    exit 1
else
    echo "⚠️  gitleaks not installed — skipping staged secret scan"
    echo "   install: go install github.com/zricethezav/gitleaks/v8@v8.30.1"
fi

if git diff --cached --name-only --diff-filter=d -- '*.py' | grep -q .; then
    if command -v ruff >/dev/null 2>&1; then
        echo "🔍 ruff: checking staged Python files..."
        git diff --cached --name-only --diff-filter=d -- '*.py' | xargs -r ruff check --
    else
        echo "⚠️  ruff not installed — skipping lint"
    fi
fi
