#!/bin/bash
# Apply the OpenWrt TollGate config over SSH (ported from provision-local-lab.sh).
set -euo pipefail
SSH="ssh -o StrictHostKeyChecking=no root@{{ openwrt_ip }}"

# procd init with stdout/stderr capture (so logrus reaches syslog)
$SSH 'cat > /etc/init.d/tollgate-wrt << "INIT"
#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1
start_service() {
  procd_open_instance
  procd_set_param command /usr/bin/tollgate-wrt
  procd_set_param respawn
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
INIT
chmod +x /etc/init.d/tollgate-wrt'

# TollGate config pointing at the local fakewallet mint
$SSH 'cat > /etc/tollgate/config.json << CFG
{
  "config_version": "v0.0.8",
  "log_level": "info",
  "accepted_mints": [{"url": "http://{{ host_ip }}:{{ cdk_mint_port }}", "min_balance": 0, "balance_tolerance_percent": 0, "price_per_step": 1, "price_unit": "sats", "purchase_min_steps": 0}],
  "profit_share": [{"factor": 1, "identity": "owner"}],
  "step_size": 22020096,
  "metric": "bytes",
  "reseller_mode": false
}
CFG'

$SSH '/etc/init.d/tollgate-wrt restart; sleep 5'
