[Unit]
Description=OpenWrt TollGate lab VM
After=network-online.target cdk-mintd.service
Wants=cdk-mintd.service

[Service]
Type=simple
ExecStart=/usr/local/bin/vm-runner -enable-kvm -cpu host -m {{ openwrt_mem_mb }} -smp {{ openwrt_smp }} -drive file={{ openwrt_overlay }},format=qcow2,if=virtio,file.locking=off -netdev bridge,id=net0,br={{ bridge_name }} -device virtio-net-pci,netdev=net0 -nographic -serial unix:/tmp/openwrt-serial.sock,server,nowait
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
