# Router Access Configuration
# Copy this file to routers.env and fill in your values.
#   cp routers.env.example routers.env
#
# routers.env is gitignored — credentials never leave your machine.
#
# SSH key auth is preferred. Add your public key to the router:
#   ssh-copy-id root@<router-ip>
#
# For NetBird networks, use the NetBird-assigned IP (typically 100.x.x.x).

ROUTER_USER ?= root

# SSH options (increase timeout for slow connections)
SSH_OPTS ?= -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new

# --- Router definitions ---
# HOST = NetBird IP, LAN_HOST = direct LAN IP (for when NetBird is down)
# SSID = open AP, PSK_SSID/PSK_PASS = encrypted AP

ROUTER_ALPHA_HOST=100.64.0.1
ROUTER_ALPHA_LAN_HOST=192.168.41.1
ROUTER_ALPHA_LABEL=alpha
ROUTER_ALPHA_SSID=TollGate-XXXX
ROUTER_ALPHA_PSK_SSID=c08r4d0r-XXXX
ROUTER_ALPHA_PSK_PASS=your-password-here

ROUTER_BETA_HOST=100.64.0.2
ROUTER_BETA_LAN_HOST=172.19.217.1
ROUTER_BETA_LABEL=beta
ROUTER_BETA_SSID=TollGate-XXXX
ROUTER_BETA_PSK_SSID=c03rad0r-XXXX
ROUTER_BETA_PSK_PASS=your-password-here

# --- Serial console (USB-TTL adapters) ---
# Persistent symlinks via udev rules. See docs/serial-integration-plan.md.
ROUTER_ALPHA_SERIAL=/dev/serial-alpha
ROUTER_BETA_SERIAL=/dev/serial-beta
SERIAL_BAUD=115200

# --- Upstream WiFi (for restore-after-test) ---
STARGATE_SSID=StarGate
STARGATE_PASS=your-password-here
