# Local testing env for tollgate-rs (no tunnel needed)
# The tollgate-wrt.service runs locally with JSON→YAML wrapper
TOLLGATE_BACKEND=rust
TOLLGATE_SSH_HOST=localhost
TOLLGATE_SSH_PORT=22
TOLLGATE_SSH_USER=root
TOLLGATE_SSH_KEY=/home/ubuntu/.ssh/id_ed25519
TOLLGATE_SSH_PASSWORD=
TOLLGATE_ROUTER_ARCH=x86_64

# Client identity (matches DHCP lease)
TOLLGATE_CLIENT_IP=10.0.0.42
TOLLGATE_CLIENT_MAC=02:00:00:00:00:01

# Cashu mint
TOLLGATE_TEST_MINT_URL=https://testnut.cashu.exchange
TOLLGATE_LOCAL_MINT_URL=https://testnut.cashu.exchange
TOLLGATE_CASHU_VENV=/home/ubuntu/.cashu-venv
